# ─── Database (Docker PostgreSQL lokal) ──────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Diisi setelah container PostgreSQL berjalan (Langkah 5, setelah Docker live).
DATABASE_URL=

# ─── Better Auth ─────────────────────────────────────────
# Secret untuk menandatangani sesi. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL dasar aplikasi (tanpa trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# ─── Seed admin (sekali jalan, prisma/seed.ts) ──────────
# TIDAK boleh berisi password produksi. Hanya untuk admin dev lokal.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ─── Publik (aman dilihat browser) ───────────────────────
# Satu-satunya NEXT_PUBLIC_ yang diizinkan (lihat docs/rules/06_SECURITY.md §1)
NEXT_PUBLIC_SITE_URL=https://salfain.web.id

# Object storage gambar sertifikat (Cloudflare R2 / S3-compatible)
# S3_PUBLIC_BASE_URL menunjuk ke domain publik bucket atau custom domain.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ─── Docker PostgreSQL lokal (dibaca docker-compose.yml) ─
# Salin berkas ini menjadi `.env` (bukan .env.local) lalu isi.
# `.env` diabaikan git — docker compose memuatnya otomatis.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
